{
  "name": "zuno",
  "version": "0.0.0",
  "private": true,
  "description": "Provider-native TypeScript integration SDKs.",
  "type": "module",
  "license": "Apache-2.0",
  "packageManager": "pnpm@10.3.0",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "build": "pnpm -r --if-present build",
    "changeset": "changeset",
    "check": "pnpm format:check && pnpm public:check && pnpm docs:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build && pnpm package:check && pnpm release:validate",
    "docs:check": "node scripts/check-docs.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "package:check": "pnpm -r --if-present package:check",
    "public:check": "node scripts/check-public-repo.mjs",
    "release": "pnpm build && changeset publish",
    "release:check": "pnpm check",
    "release:validate": "node scripts/check-release.mjs",
    "test": "vitest run --coverage --configLoader native --no-fsModuleCache",
    "test:watch": "vitest --configLoader native --no-fsModuleCache",
    "typecheck": "tsc --noEmit --pretty false -p tsconfig.eslint.json",
    "version-packages": "changeset version"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@changesets/cli": "^3.0.3",
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.5",
    "@vitest/coverage-v8": "^5.0.5",
    "eslint": "^10.13.0",
    "prettier": "^3.9.10",
    "publint": "^0.3.25",
    "tsup": "^9.0.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
